# Copy this file to .env and fill in your own Aiven values. Never commit .env.
# Aiven console -> your Kafka service -> Overview -> Connection information -> SASL
KAFKA_BOOTSTRAP_SERVERS=your-service-yourproject.a.aivencloud.com:12345
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=change-me
KAFKA_TOPIC=orders
# Download "CA certificate" from the same page and save it here
KAFKA_CA_LOCATION=certs/ca.pem
# SASL_SSL for Aiven. SASL_PLAINTEXT only for a local test broker.
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
